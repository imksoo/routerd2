{
  "boot_abi": 1,
  "worker_abi": 5,
  "entrypoint": "supervisor",
  "roles": [
    {
      "role": "firewall_log",
      "artifact": "native-workers"
    },
    {
      "role": "otlp_logs",
      "artifact": "native-workers"
    },
    {
      "role": "syslog",
      "artifact": "native-workers"
    },
    {
      "role": "logging",
      "artifact": "logger"
    },
    {
      "role": "network",
      "artifact": "native-workers"
    },
    {
      "role": "control",
      "artifact": "native-workers"
    },
    {
      "role": "management",
      "artifact": "native-workers"
    },
    {
      "role": "health",
      "artifact": "native-workers"
    },
    {
      "role": "dhcp4",
      "artifact": "native-workers"
    },
    {
      "role": "dhcp6",
      "artifact": "native-workers"
    },
    {
      "role": "dhcp_server",
      "artifact": "native-workers"
    },
    {
      "role": "ra",
      "artifact": "native-workers"
    },
    {
      "role": "ra_client",
      "artifact": "native-workers"
    },
    {
      "role": "aftr",
      "artifact": "native-workers"
    },
    {
      "role": "dns",
      "artifact": "native-workers"
    },
    {
      "role": "vrrp",
      "artifact": "native-workers"
    },
    {
      "role": "bgp",
      "artifact": "native-workers"
    },
    {
      "role": "bfd",
      "artifact": "native-workers"
    },
    {
      "role": "pppoe",
      "artifact": "native-workers"
    }
  ],
  "artifacts": [
    {
      "name": "supervisor",
      "kind": "native",
      "command": "routerd",
      "file": "/build/bin/routerd"
    },
    {
      "name": "native-workers",
      "kind": "native",
      "command": "routerd-modules",
      "file": "/build/bin/routerd-modules"
    },
    {
      "name": "logger",
      "kind": "native",
      "command": "routerd-logging",
      "file": "/build/bin/routerd-logging"
    },
    {
      "name": "notices",
      "kind": "data",
      "file": "/build/licenses/manifest.json"
    },
    {
      "name": "ppp-image",
      "kind": "data",
      "file": "/build/pppoe-engine.tar"
    },
    {
      "name": "ppp-sources",
      "kind": "data",
      "file": "/build/pppoe-sources.tar"
    }
  ],
  "engines": [
    {
      "role": "pppoe",
      "artifact": "ppp-image",
      "sources": "ppp-sources"
    }
  ]
}
