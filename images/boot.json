{
  "platform": "appliance",
  "config": "/etc/routerd/config.json",
  "runtime_dir": "/run/routerd",
  "state_dir": "/var/lib/routerd",
  "kernel_modules": [
    "virtio_pci",
    "virtio_net",
    "af_packet",
    "bridge",
    "8021q",
    "vrf",
    "vxlan",
    "macvlan",
    "wireguard",
    "nf_tables",
    "nft_ct",
    "nft_chain_nat",
    "nft_masq",
    "nft_nat",
    "nft_reject_inet",
    "nft_log",
    "nf_log_syslog",
    "ip6_tunnel"
  ],
  "ssh": {
    "listen": "0.0.0.0:22",
    "user": "admin",
    "authorized_keys": []
  },
  "workers": {
    "logging": "/usr/libexec/routerd-logging",
    "network": "/usr/libexec/routerd-modules",
    "control": "/usr/libexec/routerd-modules",
    "management": "/usr/libexec/routerd-modules",
    "health": "/usr/libexec/routerd-modules",
    "dhcp4": "/usr/libexec/routerd-modules",
    "dhcp6pd": "/usr/libexec/routerd-modules",
    "dhcp_server": "/usr/libexec/routerd-modules",
    "ra": "/usr/libexec/routerd-modules",
    "ra_client": "/usr/libexec/routerd-modules",
    "aftr": "/usr/libexec/routerd-modules",
    "dns": "/usr/libexec/routerd-modules",
    "vrrp": "/usr/libexec/routerd-modules",
    "bgp": "/usr/libexec/routerd-modules",
    "bfd": "/usr/libexec/routerd-modules"
  }
}
