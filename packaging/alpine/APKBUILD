# Local source archive and checksums are generated by build.sh before abuild.
pkgname=routerd2
pkgver=0.1.0
pkgrel=0
pkgdesc="Linux router supervisor and isolated protocol workers"
url="https://github.com/imksoo/routerd2"
arch="x86_64 aarch64"
license="BSD-3-Clause"
depends=""
makedepends="go>=1.27.3"
options="net !strip"
source="$pkgname-$pkgver.tar.gz"
builddir="$srcdir/$pkgname-$pkgver"
sha512sums=""

build() {
	export CGO_ENABLED=0
	local ldflags="-s -w -X github.com/imksoo/routerd2/internal/buildinfo.ReleaseID=${ROUTERD_RELEASE_ID:-dev}"
	# Override Alpine's default -buildmode=pie: the appliance has no ELF loader.
	go build -buildmode=exe -trimpath -buildvcs=false -ldflags "$ldflags" -o routerd ./cmd/routerd || return 1
	go build -buildmode=exe -trimpath -buildvcs=false -ldflags "$ldflags" -o routerd-modules ./cmd/routerd-modules || return 1
}

check() {
	local binary headers dynamic
	CGO_ENABLED=0 go test ./... || return 1
	for binary in routerd routerd-modules; do
		headers=$(readelf -l "$binary") || return 1
		dynamic=$(readelf -d "$binary") || return 1
		case "$headers" in *INTERP*) echo "$binary requires an ELF interpreter" >&2; return 1 ;; esac
		case "$dynamic" in *'(NEEDED)'*) echo "$binary requires shared libraries" >&2; return 1 ;; esac
	done
}

package() {
	install -Dm755 routerd "$pkgdir/usr/sbin/routerd"
	install -Dm755 routerd-modules "$pkgdir/usr/libexec/routerd-modules"
	install -Dm644 images/config-empty.json "$pkgdir/etc/routerd/config.json"
	install -Dm644 images/boot.json "$pkgdir/etc/routerd/boot.json"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
