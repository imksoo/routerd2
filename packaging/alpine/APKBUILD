# Local source archive and checksums are generated by build.sh before abuild.
pkgname=routerd2
pkgver=0.1.0
pkgrel=0
pkgdesc="Linux router supervisor and isolated protocol workers"
url="https://github.com/imksoo/routerd2"
arch="x86_64 aarch64"
license="BSD-3-Clause AND BSD-4-Clause AND BSD-4-Clause-Shortened AND GPL-2.0-or-later AND LGPL-3.0-or-later AND LGPL-2.1-or-later AND LGPL-2.0-or-later AND Public-Domain AND RSA-MD AND Apache-2.0 AND MIT"
depends=""
makedepends="go>=1.27.3 python3"
options="net !strip"
source="$pkgname-$pkgver.tar.gz"
builddir="$srcdir/$pkgname-$pkgver"
sha512sums=""

build() {
	export CGO_ENABLED=0
	local ldflags="-s -w -X github.com/imksoo/routerd2/internal/buildinfo.Identity=ROUTERD2-RELEASE-V1:${ROUTERD_RELEASE_ID:-dev}:END"
	# Override Alpine's default -buildmode=pie: the appliance has no ELF loader.
	go build -buildmode=exe -trimpath -buildvcs=false -ldflags "$ldflags" -o routerd ./cmd/routerd || return 1
	# routerd-modules was cross-linked with pinned nDPI/musl by ndpi.Dockerfile.
	test -x routerd-modules || return 1
 go build -buildmode=exe -trimpath -buildvcs=false -ldflags "$ldflags" -o routerd-logging ./cmd/routerd-logging || return 1
	python3 scripts/licenses.py --output dist/licenses --native-notices ndpi-notices || return 1
}

check() {
	umask 022
	local binary headers dynamic
	# Go 1.27's testing.TempDir uses GOTMPDIR, which abuild sets beneath aports.
	# Keep both roots short; tests still allocate private random directories.
	export TMPDIR=/tmp GOTMPDIR=/tmp
	CGO_ENABLED=0 go test ./... || return 1
	CGO_ENABLED=0 go test github.com/google/nftables/expr || return 1
	for binary in routerd routerd-modules routerd-logging; do
		headers=$(readelf -l "$binary") || return 1
		dynamic=$(readelf -d "$binary") || return 1
		case "$headers" in *INTERP*) echo "$binary requires an ELF interpreter" >&2; return 1 ;; esac
		case "$dynamic" in *'(NEEDED)'*) echo "$binary requires shared libraries" >&2; return 1 ;; esac
	done
}

package() {
	install -Dm755 routerd "$pkgdir/usr/sbin/routerd"
	install -Dm755 routerd-modules "$pkgdir/usr/libexec/routerd-modules"
	install -Dm644 chrony-engine.tar "$pkgdir/usr/lib/routerd/chrony-engine.tar"
	install -Dm644 conntrack-engine.tar "$pkgdir/usr/lib/routerd/conntrack-engine.tar"
	install -Dm644 tailscale-engine.tar "$pkgdir/usr/lib/routerd/tailscale-engine.tar"
	install -Dm644 dnsmasq-engine.tar "$pkgdir/usr/lib/routerd/dnsmasq-engine.tar"
	install -Dm644 pppoe-engine.tar "$pkgdir/usr/lib/routerd/pppoe-engine.tar"
 install -Dm755 routerd-logging "$pkgdir/usr/libexec/routerd-logging"
	install -Dm644 images/config-empty.json "$pkgdir/etc/routerd/config.json"
	install -Dm644 images/boot.json "$pkgdir/etc/routerd/boot.json"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
	mkdir -p "$pkgdir/usr/share/licenses/$pkgname/dependencies"
	cp -a dist/licenses/. "$pkgdir/usr/share/licenses/$pkgname/dependencies/"
}
